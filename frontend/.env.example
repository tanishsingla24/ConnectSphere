# Frontend Environment Variables
# Dev (default): omit both — uses /api proxy + same-origin Socket.IO (HTTPS on LAN)
# Direct to backend (no proxy): VITE_API_URL=http://localhost:5000/api
#                               VITE_SOCKET_URL=http://localhost:5000
VITE_API_URL=http://localhost:5000/api
VITE_SOCKET_URL=http://localhost:5000
